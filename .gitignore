# data — CSVs and generated batches are not tracked; keep the dirs via .gitkeep
data/raw/*
!data/raw/.gitkeep
data/incoming/*
!data/incoming/.gitkeep
data/processed/*
!data/processed/.gitkeep

# secrets
.env

# python
venv/
.venv/
__pycache__/
*.pyc

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
logs/

# os / editor
.DS_Store
.vscode/
