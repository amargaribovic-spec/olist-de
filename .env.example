# Copy to .env and set the values for your database.
# DB_HOST / DB_PORT are for running tools from your host (venv); inside
# docker-compose the services set host/port to the postgres service (5432).
DB_HOST=127.0.0.1
DB_PORT=5544
DB_NAME=olist
DB_USER=olist
DB_PASSWORD=olist
DB_SCHEMA=raw
DBT_SCHEMA=dbt_amar
